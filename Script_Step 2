# --- 3. EXPLORATORY DATA ANALYSIS (EDA) ---
print("\n--- 3. Exploratory Data Analysis (EDA) ---")

# 3.1 Overall Performance Metrics
print("\nOverall Performance Summary (Mean):")
performance_summary = df[['Conversion_Rate', 'ROI', 'Acquisition_Cost_USD', 'Clicks', 'Impressions']].mean()
print(performance_summary.to_frame().T)

# 3.2 Channel Performance Analysis
channel_performance = df.groupby('Channel_Used').agg(
    Total_Spend=('Acquisition_Cost_USD', 'sum'),
    Avg_ROI=('ROI', 'mean'),
    Avg_Conversion_Rate=('Conversion_Rate', 'mean'),
    Total_Clicks=('Clicks', 'sum')
).sort_values(by='Total_Spend', ascending=False)
print("\nChannel Performance Summary:")
print(channel_performance)

# Visualization: Channel Spend vs. ROI
plt.figure(figsize=(10, 6))
sns.scatterplot(x='Total_Spend', y='Avg_ROI', hue=channel_performance.index, data=channel_performance, s=100)
plt.title('Channel Spend vs. Average ROI')
plt.xlabel('Total Spend (USD)')
plt.ylabel('Average ROI')
plt.xscale('log')
plt.legend(bbox_to_anchor=(1.05, 1), loc=2)
plt.grid(True)
plt.savefig('channel_performance.png')
print("Saved 'channel_performance.png' chart.")
