# --- 4. CUSTOMER SEGMENTATION ANALYSIS ---

def analyze_customer_segmentation(df):
    """Calculates average metrics for each customer segment."""
    print("\n--- 4. Analyzing Customer Segmentation ---")

    segment_performance = df.groupby('Customer_Segment').agg(
        Average_ROI=('ROI', 'mean'),
        Total_Acquisition_Cost=('Acquisition_Cost', 'sum'),
        Average_Engagement_Score=('Engagement_Score', 'mean'),
        Average_Conversion_Rate=('Conversion_Rate', 'mean'),
        Count_Campaigns=('Campaign_ID', 'count')
    ).reset_index()

    # Sort by Average ROI to identify high-value segments
    segment_performance = segment_performance.sort_values(by='Average_ROI', ascending=False)

    # Save to CSV for dashboard integration
    segment_performance.to_csv('customer_segmentation_summary.csv', index=False)

    return segment_performance

