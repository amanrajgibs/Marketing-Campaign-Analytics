# --- 3. MULTI-TOUCH ATTRIBUTION PROXY & CHANNEL PERFORMANCE ---

def analyze_channel_performance(df):
    """Calculates key performance metrics by marketing channel."""
    print("\n--- 3. Analyzing Channel Performance (MTA Proxy) ---")

    channel_performance = df.groupby('Channel_Used').agg(
        Total_Acquisition_Cost=('Acquisition_Cost', 'sum'),
        Average_ROI=('ROI', 'mean'),
        Average_Conversion_Rate=('Conversion_Rate', 'mean'),
        Total_Impressions=('Impressions', 'sum'),
        Total_Clicks=('Clicks', 'sum'),
        Count_Campaigns=('Campaign_ID', 'count')
    ).reset_index()

    # Calculate **Cost per Impression** (key optimization metric)
    channel_performance['Cost_Per_Impression'] = (
        channel_performance['Total_Acquisition_Cost'] / channel_performance['Total_Impressions']
    )

    # Sort by Average ROI for budget recommendation insight
    channel_performance = channel_performance.sort_values(by='Average_ROI', ascending=False)

    # Save to CSV for dashboard integration
    channel_performance.to_csv('channel_performance_summary.csv', index=False)

    return channel_performance
