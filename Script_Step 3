# --- 2. Cross-Factor Performance Interaction Analysis (T-Test Template) ---
print("\n--- Starting Cross-Factor Interaction Analysis (T-Test Template) ---")

# Example: Test if 'Email' campaigns are significantly different from 'Social Media' 
# ONLY within the 'Women 35-44' Target Audience.

# Filter data for a specific segment
segment_df = df[df['Target_Audience'] == 'Women 35-44']

# Separate the two campaign types for comparison
group_A = segment_df[segment_df['Campaign_Type'] == 'Email']['Conversion_Rate']
group_B = segment_df[segment_df['Campaign_Type'] == 'Social Media']['Conversion_Rate']

if len(group_A) > 1 and len(group_B) > 1:
    # Perform a two-sample independent t-test
    t_stat, p_value = stats.ttest_ind(group_A, group_B, equal_var=False)

    print(f"Comparison: Email vs. Social Media for Target Audience 'Women 35-44'")
    print(f"Mean Conversion Rate (Email): {group_A.mean():.4f}")
    print(f"Mean Conversion Rate (Social Media): {group_B.mean():.4f}")
    print(f"T-statistic: {t_stat:.4f}, P-value: {p_value:.4f}")

    if p_value < 0.05:
        print("Conclusion: The difference in Conversion Rate is **statistically significant** (p < 0.05).")
    else:
        print("Conclusion: The difference in Conversion Rate is **not statistically significant** (p >= 0.05).")
else:
    print("Not enough data points in one or both groups to perform the t-test for this specific interaction.")
