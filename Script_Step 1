import pandas as pd
import numpy as np

# --- 1. CONFIGURATION ---

# The file name of your uploaded dataset
FILE_NAME = "marketing_campaign_dataset.csv"

# --- 2. DATA LOADING AND CLEANING ---

def load_and_clean_data(file_path):
    """Loads the CSV, cleans the 'Acquisition_Cost', and formats 'Date'."""
    try:
        df = pd.read_csv(file_path)
    except FileNotFoundError:
        print(f"Error: File not found at {file_path}. Please ensure the file is uploaded to Colab.")
        return None

    # Convert Acquisition_Cost to a float by removing '$' and ','
    df['Acquisition_Cost'] = (
        df['Acquisition_Cost']
        .astype(str) # Ensure it's a string before manipulation
        .str.replace('$', '', regex=False)
        .str.replace(',', '', regex=False)
        .astype(float)
    )

    # Convert Date to datetime object for time series analysis
    # Assuming 'DD-MM-YYYY' format based on inspection
    df['Date'] = pd.to_datetime(df['Date'], format='%d-%m-%Y', errors='coerce')
    df = df.dropna(subset=['Date']) # Drop rows where date conversion failed

    print("Data loaded and cleaned successfully.")
    print(f"Total records: {len(df)}")
    return df
